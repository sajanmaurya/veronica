generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id              Int             @id @default(autoincrement())
  userId          String          @unique
  name            String
  email           String
  diseases        String?
  allergies       String?
  dietaryPreferences String?
  createdAt       DateTime        @default(now())
  
  consumptions    FoodConsumption[]
  productSearches ProductSearch[] // <-- add this back-relation array field
}

model ProductSearch {
  id                 String       @id @default(cuid())
  userId             String
  productName        String?
  imageFrontUrl      String?
  imageNutritionImage String?
  aiData             Json
  clientRequestId    String?     @unique
  createdAt          DateTime     @default(now())

  userProfile        UserProfile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
}


model FoodConsumption {
  id          String      @id @default(cuid())
  userId      String
  productName String
  portion     Float
  unit        String
  nutrition   Json
  consumedAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  userProfile UserProfile @relation(fields:[userId], references:[userId], onDelete:Cascade)
  @@index([userId,consumedAt])
}

model ApiUsage {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
}
